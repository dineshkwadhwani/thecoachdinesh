{
  "version": 2,
  "installCommand": "npm install --prefix backend",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend/**,frontend/**}"
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
