{
  "version": 2,
  "installCommand": "npm install --prefix backend",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{backend/**,frontend/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dineshwadhwani.online"
        }
      ],
      "status": 308,
      "dest": "https://www.thecoachdinesh.com/portfolio.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.dineshwadhwani.online"
        }
      ],
      "status": 308,
      "dest": "https://www.thecoachdinesh.com/portfolio.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
