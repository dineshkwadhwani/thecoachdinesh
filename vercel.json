{
  "version": 2,
  "installCommand": "npm install --prefix backend",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{backend/**,frontend/**,courses/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "^(?!portfolio\\.html).*",
      "host": "^(www\\.)?dineshwadhwani\\.online$",
      "status": 301,
      "headers": {
        "location": "https://www.thecoachdinesh.com/portfolio.html"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
